program main
    use cudafor
    use kernels_peridinamica
    use omp_lib
  
  implicit none
  
  integer ndivx, ndivy, totnode, nt, maxfam, nnum, cnode, i, j, tt, nbnd, totint, totbottom, tottop
  parameter(ndivx = 500)
  parameter(ndivy = 500)
  parameter(nbnd = 3)
  parameter(totnode = ndivx*(ndivy + 2 * nbnd))
  parameter(nt = 1250)
  parameter(maxfam = 100)
  
  real *8 length,width, dx, delta, thick, dens, emod, pratio, area, vol, bc
  real *8 sedload1, sedload2, dt, totime, ctime, idist, fac, radij, nlength, dforce1, dforce2
  real *8 crlength, scr0, pi
  
  real *8 coord(totnode,2), pforce(totnode,2), pforceold(totnode,2), bforce(totnode,2), stendens(totnode,2)
  real *8 fncst(totnode,2), disp(totnode,2), vel(totnode,2), velhalfold(totnode,2), velhalf(totnode,2)
  real *8 acc(totnode,2), massvec(totnode,2)
  
  ! Transformados em vetores 1D assim como no Offloading
  real *8 enddisp(nt), endtime(nt), dmg(totnode)
  integer numfam(totnode), pointfam(totnode), fail(totnode,maxfam)
  
  ! Arrays dinâmicos para CPU e GPU
  integer, allocatable :: nodefam(:)
  integer, device, allocatable :: nodefam_d(:)
  integer :: total_family_size
  
  real(8), device, allocatable :: coord_d(:,:)
  integer, device, allocatable :: numfam_d(:)
  integer, device, allocatable :: pointfam_d(:)
  
  type(dim3) :: grid, block, grid_familia
  integer :: threadsPorBloco, numBlocos, err_cuda
  
  ! Variaveis para Timer
  real*8 :: t_inicio_numfam_sim, t_final_numfam_sim, t1, t2
  real*8 :: tempo_total_sim_s, tempo_parte_a, tempo_parte_b, tempo_parte_c
  
  real(8) :: t_bc_inicio_total, t_bc_fim_kernel, t_bc_fim_sync, t_bc_fim_d2h
  real(8) :: tempo_bc_kernel_s = 0.0d0, tempo_bc_sync_s = 0.0d0, tempo_bc_d2h_s = 0.0d0
  real(8) :: tempo_total_bc_cuda_s = 0.0d0
  
  integer :: n_bordas, ierr
  
  real(8), device, allocatable :: d_vel(:,:), d_disp(:,:), d_pforce(:,:), d_fncst(:,:)
  real(8), device, allocatable :: d_dmg(:), d_bforce(:,:)
  integer, device, allocatable :: d_fail(:,:)
  
  real(8) :: t_i_inicio, t_i_fim, tempo_total_integra_s = 0.0d0
  real(8) :: t_inicio_io, t_final_io, tempo_total_io_s = 0.0d0
  real(8) :: t_inicio_total, t_final_total, tempo_wall_clock = 0.0d0
  real(8) :: t_f_inicio, t_f_kernel, t_f_sync, t_f_d2h
  real(8) :: tempo_forca_kernel_s = 0.0d0, tempo_forca_sync_s = 0.0d0
  real(8) :: tempo_forca_d2h_s = 0.0d0, tempo_total_forca_cuda_s = 0.0d0
  
  t_inicio_total = omp_get_wtime() 
  pi = dacos(-1.0d0)
  
  do i = 1, totnode
      coord(i,1) = 0.0d0
      coord(i,2) = 0.0d0
      numfam(i) = 0
      pointfam(i) = 0
      pforce(i,1) = 0.0d0
      pforce(i,2) = 0.0d0
      pforceold(i,1) = 0.0d0
      pforceold(i,2) = 0.0d0
      bforce(i,1) = 0.0d0
      bforce(i,2) = 0.0d0
      stendens(i,1) = 0.0d0
      stendens(i,2) = 0.0d0
      fncst(i,1) = 1.0d0
      fncst(i,2) = 1.0d0
      disp(i,1) = 0.0d0
      disp(i,2) = 0.0d0
      vel(i,1) = 0.0d0
      vel(i,2) = 0.0d0
      velhalfold(i,1) = 0.0d0
      velhalfold(i,2) = 0.0d0
      velhalf(i,1) = 0.0d0
      velhalf(i,2) = 0.0d0
      acc(i,1) = 0.0d0
      acc(i,2) = 0.0d0
      massvec(i,1) = 0.0d0
      massvec(i,2) = 0.0d0
      do j = 1, maxfam
          fail(i,j) = 0
      enddo
      dmg(i) = 0.0d0
  enddo
  
  length = 0.05d0
  width = 0.05d0
  dx = length / ndivx
  delta = 3.015d0 * dx
  thick = dx
  dens = 8000.0d0
  emod = 192.0d9
  pratio = 1.0d0 / 3.0d0
  area = dx * dx
  vol = area * dx
  bc = 9.0d0 * emod / (pi * thick * (delta**3))
  sedload1 = 9.0d0 / 16.0d0 * emod * 1.0d-6
  sedload2 = 9.0d0 / 16.0d0 * emod * 1.0d-6
  dt = 0.8d0 * dsqrt(2.0d0*dens*dx/(pi*delta**2*dx*bc))
  totime = nt * dt
  ctime = 0.0d0
  idist = 0.0d0
  do i = 1, nt
      enddisp(i) = 0.0d0
      endtime(i) = 0.0d0
  enddo
  fac = 0.0d0
  radij = dx / 2.0d0
  nnum = 0
  cnode = 0
  nlength  = 0.0d0
  dforce1 = 0.0d0
  dforce2 = 0.0d0
  crlength = 0.01d0
  scr0 = 0.04472d0
  
  do i = 1,totnode
      do j = 1,maxfam
          fail(i,j) = 1
      enddo
  enddo
  
  do i = 1,ndivy
      do j = 1,ndivx
          nnum = nnum + 1
          coord(nnum,1) = (-1.0d0 * length / 2.0d0) + (dx / 2.0d0) + (j-1) * dx
          coord(nnum,2) = (-1.0d0 * width / 2.0d0) + (dx / 2.0d0) + (i-1) * dx
      enddo
  enddo
  totint = nnum
  
  do i = 1,nbnd
      do j = 1,ndivx
          nnum = nnum + 1
          coord(nnum,1) = -1.0d0 / 2.0d0 * length + (dx / 2.0d0) + (j - 1) * dx
          coord(nnum,2) = -1.0d0 / 2.0d0 * width - (dx / 2.0d0) - (i - 1) * dx
      enddo
  enddo
  totbottom = nnum
  
  do i = 1,nbnd
      do j = 1,ndivx
          nnum = nnum + 1
          coord(nnum,1) = -1.0d0 / 2.0d0 * length + (dx / 2.0d0) + (j - 1) * dx
          coord(nnum,2) =  1.0d0 / 2.0d0 * width + (dx / 2.0d0) + (i - 1) * dx
      enddo
  enddo
  tottop = nnum
  
  !------------------------------- PRE-PROCESSAMENTO GPU --------------------------------------------!
  
  block = dim3(256, 1, 1)
  grid_familia = dim3((totnode + 255) / 256, 1, 1)
  
  allocate(coord_d(totnode, 2))
  allocate(numfam_d(totnode))
  allocate(pointfam_d(totnode))
  
  coord_d(1:totnode, 1:2) = coord(1:totnode, 1:2)
  numfam_d(1:totnode) = 0
  pointfam_d(1:totnode) = 0
  
  t_inicio_numfam_sim = omp_get_wtime()
  
  ! Parte A: GPU Count
  t1 = omp_get_wtime()
  call count_neighbors_gpu<<<grid_familia, block>>>(totnode, coord_d, delta, numfam_d)
  err_cuda = cudaDeviceSynchronize()
  t2 = omp_get_wtime()
  tempo_parte_a = t2 - t1
  
  ! Parte B: Scan na CPU
  numfam(1:totnode) = numfam_d(1:totnode)
  t1 = omp_get_wtime()
  pointfam(1) = 1
  do i = 2, totnode
      pointfam(i) = pointfam(i-1) + numfam(i-1)
  enddo
  
  ! ALOCAÇÃO DINÂMICA com o tamanho exato da malha
  total_family_size = pointfam(totnode) + numfam(totnode) - 1
  allocate(nodefam(total_family_size))
  allocate(nodefam_d(total_family_size))
  
  t2 = omp_get_wtime()
  tempo_parte_b = t2 - t1
  
  ! Parte C: GPU Fill
  t1 = omp_get_wtime()
  pointfam_d(1:totnode) = pointfam(1:totnode)
  
  call fill_nodefam_gpu<<<grid_familia, block>>>(totnode, coord_d, delta, pointfam_d, nodefam_d)
  err_cuda = cudaDeviceSynchronize()
  
  ! Traz os dados para processar a trinca na CPU
  nodefam(1:total_family_size) = nodefam_d(1:total_family_size)
  t2 = omp_get_wtime()
  tempo_parte_c = t2 - t1
  
  t_final_numfam_sim = omp_get_wtime()
  tempo_total_sim_s = t_final_numfam_sim - t_inicio_numfam_sim
  
  !-------------------------------- TRINCA E CONDIÇOES INICIAIS ------------------------------------!
  
  do i = 1,totnode
      do j = 1,numfam(i)
          cnode = nodefam(pointfam(i)+j-1)
          if ((coord(cnode,2) > 0.0d0).and.(coord(i,2) < 0.0d0)) then
              if ((dabs(coord(i,1)) - (crlength / 2.0d0)).le.1.0d-10) fail(i,j) = 0
              if ((dabs(coord(cnode,1)) - (crlength / 2.0d0)).le.1.0d-10) fail(i,j) = 0
          elseif ((coord(i,2) > 0.0d0).and.(coord(cnode,2) < 0.0d0)) then
              if((dabs(coord(i,1)) - (crlength / 2.0d0)).le.1.0d-10) fail(i,j) = 0
              if((dabs(coord(cnode,1)) - (crlength / 2.0d0)).le.1.0d-10) fail(i,j) = 0
          endif
      enddo
  enddo
  
  do i = 1,totnode
      disp(i,1) = 0.001d0 * coord(i,1)
      disp(i,2) = 0.0d0
  enddo
  
  do i = 1,totnode
      stendens(i,1) = 0.0d0
      do j = 1,numfam(i)
          cnode = nodefam(pointfam(i)+j-1)
          idist = dsqrt((coord(cnode,1) - coord(i,1))**2 + (coord(cnode,2) - coord(i,2))**2)
          nlength = dsqrt((coord(cnode,1) + disp(cnode,1) - coord(i,1) - disp(i,1))**2 + &
                          (coord(cnode,2) + disp(cnode,2) - coord(i,2) - disp(i,2))**2)
          if (idist.le.delta-radij) then
              fac = 1.0d0
          elseif (idist.le.delta+radij) then
              fac = (delta+radij-idist)/(2.0d0*radij)
          else
              fac = 0.0d0
          endif
          stendens(i,1) = stendens(i,1) + 0.5d0 * 0.5d0 * bc * ((nlength - idist) / idist)**2 * idist * vol * fac
      enddo
      fncst(i,1) = sedload1 / stendens(i,1)
  enddo
  
  do i = 1,totnode
      disp(i,1) = 0.0d0
      disp(i,2) = 0.001d0 * coord(i,2)
  enddo
  
  do i = 1,totnode
      stendens(i,2) = 0.0d0
      do j = 1,numfam(i)
          cnode = nodefam(pointfam(i)+j-1)
          idist = dsqrt((coord(cnode,1) - coord(i,1))**2 + (coord(cnode,2) - coord(i,2))**2)
          nlength = dsqrt((coord(cnode,1) + disp(cnode,1) - coord(i,1) - disp(i,1))**2 + &
                          (coord(cnode,2) + disp(cnode,2) - coord(i,2) - disp(i,2))**2)
          if (idist.le.delta-radij) then
              fac = 1.0d0
          elseif (idist.le.delta+radij) then
              fac = (delta+radij-idist)/(2.0d0*radij)
          else
              fac = 0.0d0
          endif
          stendens(i,2) = stendens(i,2) + 0.5d0 * 0.5d0 * bc * ((nlength - idist) / idist)**2 * idist * vol * fac
      enddo
      fncst(i,2) = sedload2 / stendens(i,2)
  enddo
  
  do i = 1,totnode
      vel(i,1) = 0.0d0
      vel(i,2) = 0.0d0
      disp(i,1) = 0.0d0
      disp(i,2) = 0.0d0
  enddo
  
  !-------------------------------- ALOCAÇÃO FINAL GPU ------------------------------------!
  
  block = dim3(256, 1, 1)
  n_bordas = tottop - totint
  grid = dim3((n_bordas + block%x - 1) / block%x, 1, 1)
  
  allocate(d_vel(totnode, 2), d_disp(totnode, 2))
  allocate(d_pforce(totnode, 2), d_fncst(totnode, 2), d_dmg(totnode))
  allocate(d_fail(totnode, maxfam), d_bforce(totnode, 2))
  
  d_vel(1:totnode, 1:2) = vel(1:totnode, 1:2)
  d_disp(1:totnode, 1:2) = disp(1:totnode, 1:2)
  d_bforce(1:totnode, 1:2) = bforce(1:totnode, 1:2)
  d_fncst(1:totnode, 1:2) = fncst(1:totnode, 1:2)
  d_fail(1:totnode, :) = fail(1:totnode, :)
  d_dmg(1:totnode) = dmg(1:totnode)
  
  !-------------------------------- INTEGRAÇÃO TEMPORAL ------------------------------------!
  
  do tt = 1,nt
      write(*,*) 'tt = ', tt
      ctime = tt * dt
  
      ! KERNEL 3: APLICA AS CONDIÇÕES DE CONTORNO
      t_bc_inicio_total = omp_get_wtime()
      call apply_bc_gpu<<<grid, block>>>(totint, totbottom, tottop, tt, dt, d_vel, d_disp)
      ierr = cudaDeviceSynchronize()
      t_bc_fim_sync = omp_get_wtime()
      tempo_total_bc_cuda_s = tempo_total_bc_cuda_s + (t_bc_fim_sync - t_bc_inicio_total)
  
      ! KERNEL 4: CALCULA AS FORÇAS E O DANO
      t_f_inicio = omp_get_wtime()
      call compute_force_damage_gpu<<<grid_familia, block>>>(totnode, maxfam, coord_d, d_disp, d_pforce, &
                                                           d_fail, d_dmg, numfam_d, pointfam_d, nodefam_d, &
                                                           d_fncst, delta, radij, pi, bc, vol, scr0, length)
      ierr = cudaDeviceSynchronize()
      t_f_sync = omp_get_wtime()
      tempo_total_forca_cuda_s = tempo_total_forca_cuda_s + (t_f_sync - t_f_inicio)
  
      ! KERNEL 5: INTEGRADOR DA CINEMÁTICA
      t_i_inicio = omp_get_wtime()
      call integrate_kinematics_gpu<<<grid_familia, block>>>(totnode, totint, dens, dt, d_pforce, d_bforce, d_vel, d_disp)
      ierr = cudaDeviceSynchronize()
      t_i_fim = omp_get_wtime()
      tempo_total_integra_s = tempo_total_integra_s + (t_i_fim - t_i_inicio)
  
      ! Resgate dos dados para escrever os resultados
      if (tt.eq.750 .or. tt.eq.1000 .or. tt.eq.1250) then
          disp(1:totnode, 1:2) = d_disp(1:totnode, 1:2)
          dmg(1:totnode) = d_dmg(1:totnode)
  
          if (tt.eq.750) then
              open(26,file = 'coord_disp_pd_750_pwc_v20.txt')
              do i = 1, totint
                  write(26,111) coord(i,1), coord(i,2), disp(i,1), disp(i,2), dmg(i)
              enddo
              close(26)
          elseif (tt.eq.1000) then
              open(26,file = 'coord_disp_pd_1000_pwc_v20.txt')
              do i = 1, totint
                  write(26,111) coord(i,1), coord(i,2), disp(i,1), disp(i,2), dmg(i)
              enddo
              close(26)
          elseif (tt.eq.1250) then
              open(26,file = 'coord_disp_pd_1250_pwc_v20.txt')
              do i = 1, totint
                  write(26,111) coord(i,1), coord(i,2), disp(i,1), disp(i,2), dmg(i)
              enddo
              close(26)
          endif
      endif
  
  enddo
  
  111 format(e12.5,3x,e12.5,3x,e12.5,3x,e12.5,3x,e12.5)
  
  ! --------------------------- Inicio da escrita dos resultados -------------------------------
  t_inicio_io = omp_get_wtime()
  
  open(unit=26, file='familia_resultados_cuda.txt', status='replace')
  
  write(26, *) "===================================================="
  write(26, *) "INDICE DOS PONTOS DE CADA FAMILIA (POINTFAM)"
  write(26, *) "Formato: (Indice do Ponto, Indice de Inicio em NODEFAM)"
  write(26, *) "===================================================="
  do i = 1, totnode
      write(26, '(I10, A, I10)') i, " , ", pointfam(i)
  enddo
  
  write(26, *) ""
  write(26, *) "===================================================="
  write(26, *) "PONTOS QUE COMPOEM A FAMILIA (NODEFAM)"
  write(26, *) "Formato: Familia do Ponto X (Total: Y)"
  write(26, *) "         [lista de pontos j]"
  write(26, *) "===================================================="
  do i = 1, totnode
      write(26, '(A, I10, A, I6, A)') "Familia do Ponto ", i, " (Total: ", numfam(i), ")"
  
      if (numfam(i) > 0) then
          do j = 1, numfam(i)
              write(26, '(I10, 1x)', advance='no') nodefam(pointfam(i) + j - 1)
          enddo
          write(26, *)
      else
          write(26, '(A)') "  (Familia vazia)"
      endif
      write(26, *)
  enddo
  
  ! Desalocações Finais
  deallocate(coord_d, numfam_d, pointfam_d, nodefam, nodefam_d)
  deallocate(d_vel, d_disp, d_pforce, d_fncst, d_dmg, d_fail, d_bforce)
  
  t_final_io = omp_get_wtime()
  tempo_total_io_s = t_final_io - t_inicio_io
  
  t_final_total = omp_get_wtime()
  tempo_wall_clock = t_final_total - t_inicio_total
  
  write(26, *) ""
  write(26, *) "===== RESUMO DE PERFORMANCE (CUDA FORTRAN) ====="
  write(26, '(A, F12.6, A)') "Tempo Total da Topologia (Fase 1+2+3): ", tempo_total_sim_s, " s"
  write(26, '(A, F12.6, A)') "  -> Parte 1 (GPU Count):                ", tempo_parte_a, " s"
  write(26, '(A, F12.6, A)') "  -> Parte 2 (CPU Scan/Prefix Sum):      ", tempo_parte_b, " s"
  write(26, '(A, F12.6, A)') "  -> Parte 3 (GPU Fill nodefam):         ", tempo_parte_c, " s"
  write(26, '(A, F12.6, A)') "Tempo das Condicoes (Kernel 3):        ", tempo_total_bc_cuda_s, " s"
  write(26, '(A, F12.6, A)') "Tempo de Forcas/Dano (Kernel 4):       ", tempo_total_forca_cuda_s, " s"
  write(26, '(A, F12.6, A)') "Tempo do Integrador (Kernel 5):        ", tempo_total_integra_s, " s"
  write(26, '(A, F12.6, A)') "Tempo de Escrita (I/O):                ", tempo_total_io_s, " s"
  write(26, '(A, F12.6, A)') "Tempo Total do Programa (Wall-clock):  ", tempo_wall_clock, " s"
  write(26, *) "--------------------------------------------------"
  if (tempo_wall_clock > 0.0d0) then
      write(26, '(A, F12.2, A)') "Impacto das Forcas no Tempo Total:     ", (tempo_total_forca_cuda_s / tempo_wall_clock) * 100.0d0, " %"
  endif
  write(26, *) "================================================"
  
  close(26)
  
  print *, "Simulacao finalizada com sucesso!"
  print *, "O relatorio de performance foi salvo no final de 'familia_resultados_cuda.txt'."
  
  end program main
